# Copy to .env and fill in. Share real values privately (never commit .env).

# Boson / Higgs. Each participant has their own key with free hackathon credits.
BOSON_API_KEY=
# Optional: a second key for the examiner's brain session. Two sessions on one key slow each other's
# responses (agent/CLAUDE.md "Higgs brain"); empty means the brain uses BOSON_API_KEY.
BOSON_BRAIN_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview
BOSON_CAPTION_MODEL=higgs-stt-3.1

# LiveKit Cloud. BOTH teammates must use the SAME project, or agent and browser never meet.
# The avatar refuses self-hosted LiveKit.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Claude (slide prep and scorecard). Haiku keeps costs to pennies.
ANTHROPIC_API_KEY=
VIVA_HAIKU_MODEL=claude-haiku-5-5

# App
# 1 = avatar examiner, 0 = voice-only fallback (no avatar session)
VIVA_AVATAR=1
# 0 = no web search fact-checks
VIVA_FACTCHECK=1
# The server starts the examiner agent when a session page opens (0 = start it by hand)
VIVA_AUTOSTART_AGENT=1
# An agent started by the server leaves when the presenter leaves, or after this many seconds if none ever joins
VIVA_AGENT_IDLE_EXIT_S=300
VIVA_SERVER_URL=http://localhost:8000
VITE_SERVER_URL=http://localhost:8000
